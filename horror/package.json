{
  "name": "indonesian-horror-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.js",
    "generate:shorts": "node scripts/generateShorts.js",
    "render": "remotion render remotion/index.jsx HorrorVideo out/indonesian-horror.mp4 --codec=h264 --crf=22",
    "upload:youtube": "node scripts/uploadYoutube.js",
    "build:video": "npm run generate && npm run render",
    "upload:shorts": "node scripts/uploadShorts.js",
    "generate:season": "node scripts/series.js plan",
    "generate:episode": "node scripts/series.js episode",
    "generate:episode-assets": "node scripts/generate.js --story-file data/story.json",
    "upload:episode": "node scripts/uploadEpisode.js",
    "stage:images": "node scripts/episode-stage.js images",
    "stage:audio": "node scripts/episode-stage.js audio",
    "stage:render": "node scripts/episode-stage.js render",
    "stage:thumbnail": "node scripts/episode-stage.js thumbnail",
    "generate:long": "node scripts/long-video.js",
    "generate:long-season": "node scripts/series.js plan --format long",
    "generate:long-episode": "node scripts/series.js episode --format long"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@remotion/cli": "^4.0.539",
    "dotenv": "^16.6.1",
    "googleapis": "^144.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539",
    "sharp": "^0.33.5"
  }
}
